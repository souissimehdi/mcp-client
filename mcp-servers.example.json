{
  "mcpServers": {
    "spring-ai-mcp": {
      "command": "<ABSOLUTE_PATH_TO_JAVA_EXE>",
      "args": [
        "-jar",
        "<ABSOLUTE_PATH_TO_MCP_SERVER_JAR>"
      ]
    },
    "filesystem": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "<ABSOLUTE_PATH_TO_ALLOWED_DIRECTORY>"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ]
    }
  }
}
